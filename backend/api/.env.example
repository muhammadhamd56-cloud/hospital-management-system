# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hms_nest?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Encrypts each user's TOTP (MFA) secret at rest with AES-256-GCM.
# Exactly 32 random bytes, given as base64 (44 chars) or as 64 hex characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#            or:      openssl rand -hex 32
# REQUIRED when NODE_ENV=production (the app refuses to boot without it).
# Optional in development/test: if unset, secrets are stored as plain text
# and a warning is logged once at startup. Existing plain-text secrets are
# re-encrypted automatically the next time they verify a code once a key is set.
# Never change or lose this key once real users have enabled MFA: secrets
# encrypted with the old key can no longer be read, and those users would
# need MFA reset.
MFA_ENCRYPTION_KEY=""

# Google OAuth 2.0 (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
# Must exactly match an "Authorized redirect URI" configured in Google Cloud Console.
# Note the /api prefix -- every route in this app is mounted under /api
# (app.setGlobalPrefix('api') in main.ts), so the real route is
# /api/auth/google/callback, not /auth/google/callback.
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# Where the browser is sent after a successful/failed Google login
CLIENT_URL="http://localhost:5173"

# Resend (resend.com) -- sends the OTP verification email at signup.
# Free tier, no credit card. Without a verified domain, RESEND_FROM_EMAIL
# must stay "onboarding@resend.dev" and delivery is limited to the address
# you signed up to Resend with (its sandbox restriction, not this app's).
# If left unset, the OTP is logged to the server console instead of emailed.
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Stripe (stripe.com) -- lets patients pay their invoices online via Stripe
# Checkout. Use TEST-mode keys (dashboard.stripe.com/test/apikeys) while
# developing -- test payments use Stripe's test card numbers, never real
# money. If left unset, the "Pay now" flow returns a clear error instead of
# silently pretending to succeed. Prefer a *restricted* key (rk_..., scoped
# to only Checkout Sessions + Webhook Endpoints) over the full secret key
# (sk_...) once you're past initial local testing -- dashboard.stripe.com/apikeys.
STRIPE_SECRET_KEY="sk_test_your_secret_key"
# From the Stripe CLI (`stripe listen --forward-to localhost:3000/api/billing/webhooks/stripe`)
# in dev, or the webhook endpoint's signing secret in the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

# Admin AI Copilot (src/admin-ai) -- admin-only operations copilot running on a
# local model through Ollama (ollama.com). Every flag defaults to its safe value;
# see docs/ai/AI_DEPLOYMENT.md before enabling.
# Master switch: when false every /api/admin-ai route returns 404.
ADMIN_AI_ENABLED=false
AI_PROVIDER="ollama"
# Ollama server, reached from this backend only (never from the browser).
AI_BASE_URL="http://localhost:11434"
# Any Ollama model tag that supports tool calling. Pull it first: ollama pull qwen2.5:3b
# See docs/ai/AI_DEPLOYMENT.md (Choosing a model) for the hardware benchmark.
AI_MODEL="qwen2.5:3b"
# Optional -- only for an Ollama behind an authenticating proxy (sent as a Bearer token).
AI_API_KEY=""
# Ollama context window (num_ctx). Ollama's small default truncates the tool list.
AI_CONTEXT_TOKENS=8192
AI_MAX_OUTPUT_TOKENS=4096
# Whole-request wall clock limit in milliseconds. A 3B model on a laptop CPU
# needs 30 s to 2 min per answer, so this allows 5 min.
AI_REQUEST_TIMEOUT=300000
AI_MAX_TOOL_CALLS=12
# Tokens (input + output) one admin may use per UTC day. 0 = unlimited.
AI_DAILY_BUDGET=500000
# When false, patient identifiers are pseudonymised before reaching the model.
AI_ALLOW_PHI=false
# Keep false until the approval + audit workflow is signed off in your environment.
AI_ENABLE_WRITES=false
# Reserved -- knowledge retrieval is not implemented yet.
AI_RAG_ENABLED=false

# Sentry (sentry.io) -- reports uncaught 500s and process-level crashes.
# If left unset, Sentry.init() becomes a no-op and errors just aren't reported.
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_ENVIRONMENT="development"

PORT=3000
