# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hms_nest?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Google OAuth 2.0 (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
# Must exactly match an "Authorized redirect URI" configured in Google Cloud Console.
# Note the /api prefix -- every route in this app is mounted under /api
# (app.setGlobalPrefix('api') in main.ts), so the real route is
# /api/auth/google/callback, not /auth/google/callback.
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# Where the browser is sent after a successful/failed Google login
CLIENT_URL="http://localhost:5173"

# Resend (resend.com) -- sends the OTP verification email at signup.
# Free tier, no credit card. Without a verified domain, RESEND_FROM_EMAIL
# must stay "onboarding@resend.dev" and delivery is limited to the address
# you signed up to Resend with (its sandbox restriction, not this app's).
# If left unset, the OTP is logged to the server console instead of emailed.
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Stripe (stripe.com) -- lets patients pay their invoices online via Stripe
# Checkout. Use TEST-mode keys (dashboard.stripe.com/test/apikeys) while
# developing -- test payments use Stripe's test card numbers, never real
# money. If left unset, the "Pay now" flow returns a clear error instead of
# silently pretending to succeed. Prefer a *restricted* key (rk_..., scoped
# to only Checkout Sessions + Webhook Endpoints) over the full secret key
# (sk_...) once you're past initial local testing -- dashboard.stripe.com/apikeys.
STRIPE_SECRET_KEY="sk_test_your_secret_key"
# From the Stripe CLI (`stripe listen --forward-to localhost:3000/api/billing/webhooks/stripe`)
# in dev, or the webhook endpoint's signing secret in the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

# Anthropic (console.anthropic.com) -- powers the AI Assistant (the floating
# chat button). Never exposed to the frontend; only this backend calls the
# API. If left unset, the assistant returns a clear "not configured" error
# instead of silently failing.
ANTHROPIC_API_KEY="sk-ant-your-api-key"
# Optional -- defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL="claude-sonnet-5"

PORT=3000
