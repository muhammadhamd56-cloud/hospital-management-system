# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hms_nest?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Google OAuth 2.0 (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
# Must exactly match an "Authorized redirect URI" configured in Google Cloud Console.
# Note the /api prefix -- every route in this app is mounted under /api
# (app.setGlobalPrefix('api') in main.ts), so the real route is
# /api/auth/google/callback, not /auth/google/callback.
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# Where the browser is sent after a successful/failed Google login
CLIENT_URL="http://localhost:5173"

# Resend (resend.com) -- sends the OTP verification email at signup.
# Free tier, no credit card. Without a verified domain, RESEND_FROM_EMAIL
# must stay "onboarding@resend.dev" and delivery is limited to the address
# you signed up to Resend with (its sandbox restriction, not this app's).
# If left unset, the OTP is logged to the server console instead of emailed.
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="onboarding@resend.dev"

PORT=3000
