# Leave EMPTY, locally and in production. The app always calls relative /api:
# locally Vite proxies it to http://localhost:3000 (vite.config.ts); on Vercel
# the /api rewrite in vercel.json proxies it to the Render backend. Same-origin
# is what makes the httpOnly session cookies first-party -- pointing this at
# another domain breaks sign-in (the Vercel build refuses to run if it's set).
VITE_API_URL=

# Sentry (sentry.io) -- reports uncaught route errors from the browser.
# Leave unset to disable reporting (e.g. in local dev).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=

# "true" for the public portfolio demo -- shows one-click demo account logins.
VITE_DEMO_MODE=
