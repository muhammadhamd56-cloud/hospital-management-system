# Absolute URL of the deployed backend API, e.g. https://your-backend.onrender.com
# Leave unset for local dev — Vite's dev server proxy (vite.config.ts) forwards
# relative /api calls to http://localhost:3000 instead.
VITE_API_URL=

# Sentry (sentry.io) -- reports uncaught route errors from the browser.
# Leave unset to disable reporting (e.g. in local dev).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
